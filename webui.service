[Service]
Type=simple
User=ubuntu
Environment="HOME=/home/ubuntu"
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/webui
ExecStart=/usr/local/bin/gunicorn \
    --worker-class gevent \
    --workers 1 \
    --bind 0.0.0.0:5000 \
    --timeout 120 \
    --keep-alive 5 \
    webui:app
Restart=on-failure
RestartSec=2s
StartLimitIntervalSec=30
StartLimitBurst=10
TimeoutStopSec=5
